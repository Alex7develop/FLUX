# Public Supabase keys only. Never put a service-role key in frontend apps.
# Leave blank until a project is provisioned.

# Web (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Mobile (Expo)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# WebRTC (optional TURN for phone ↔ laptop across NAT)
VITE_STUN_URLS=stun:stun.l.google.com:19302
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Billing (publishable key only — never a secret key)
VITE_STRIPE_PUBLISHABLE_KEY=
